{
  "$description": "The default theme's tokens that both color modes share, in the Design Tokens Community Group format. light.json and dark.json hold the colors.",
  "color": {
    "$type": "color",
    "primary": {
      "$description": "Fills that stand out, like a solid button or a checked checkbox.",
      "$value": "{color.foreground}"
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": "{color.background}"
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": "{color.foreground}"
    }
  },
  "shadow": {
    "$type": "shadow",
    "drop": {
      "$description": "Under a raised control, like a button.",
      "$value": {
        "color": "{shadow-color.drop}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 3,
          "unit": "px"
        },
        "spread": {
          "value": -1,
          "unit": "px"
        }
      }
    },
    "drop-pressed": {
      "$description": "Under a pressed raised control.",
      "$value": {
        "color": "{shadow-color.drop}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 1,
          "unit": "px"
        },
        "spread": {
          "value": -1,
          "unit": "px"
        }
      }
