{
  "$description": "The Material theme's light colors, made from #6750A4 by scripts/build-material.mjs. Each mode has the same tokens.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9922, 0.9686, 1],
        "hex": "#fdf7ff"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1137, 0.1059, 0.1255],
        "hex": "#1d1b20"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9922, 0.9686, 1],
        "hex": "#fdf7ff"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.949, 0.9255, 0.9569],
        "hex": "#f2ecf4"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9255, 0.902, 0.9333],
        "hex": "#ece6ee"
      }
    },
    "muted": {
      "$description": "A quiet surface, like a hovered item.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1137, 0.1059, 0.1255],
        "alpha": 0.08,
        "hex": "#1d1b20"
      }
    },
    "muted-foreground": {
      "$description": "Secondary text, like a description.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2863, 0.2706, 0.3059],
        "hex": "#49454e"
      }
    },
    "primary": {
      "$description": "Fills that stand out, like a checked checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.3961, 0.3333, 0.5608],
        "hex": "#65558f"
      }
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "ring": {
      "$description": "The focus ring.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.3961, 0.3333, 0.5608],
        "alpha": 0.4,
        "hex": "#65558f"
      }
    },
    "input": {
      "$description": "The border of a control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4784, 0.4588, 0.498],
        "hex": "#7a757f"
      }
    },
    "border": {
      "$description": "Dividers and quiet borders.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7922, 0.7686, 0.8118],
        "hex": "#cac4cf"
      }
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4784, 0.4588, 0.498],
        "hex": "#7a757f"
      }
    },
    "border-disabled": {
      "$description": "The border and text of a disabled control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1137, 0.1059, 0.1255],
        "alpha": 0.38,
        "hex": "#1d1b20"
      }
    },
    "destructive": {
      "$description": "Errors.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7294, 0.102, 0.102],
        "hex": "#ba1a1a"
      }
    },
    "destructive-muted": {
      "$description": "A surface behind an error.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.8549, 0.8392],
        "hex": "#ffdad6"
      }
    },
    "overlay": {
      "$description": "Behind a modal dialog or drawer.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.32,
        "hex": "#000000"
      }
    },
    "field": {
      "$description": "The fill of a text field.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.902, 0.8784, 0.9137],
        "hex": "#e6e0e9"
      }
    }
  },
  "shadow-color": {
    "$type": "color",
    "key": {
      "$description": "The key shadow of a raised surface.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.3,
        "hex": "#000000"
      }
    },
    "ambient": {
      "$description": "The ambient shadow of a raised surface.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.15,
        "hex": "#000000"
      }
    },
    "none": {
      "$description": "No shadow.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0,
        "hex": "#000000"
      }
    }
  }
}
