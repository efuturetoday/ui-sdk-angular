{
  "$description": "The Material theme's orange palette in light, made from #FF9800 by scripts/build-material.mjs.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.9725, 0.9608],
        "hex": "#fff8f5"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1294, 0.102, 0.0784],
        "hex": "#211a14"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.9725, 0.9608],
        "hex": "#fff8f5"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9804, 0.9216, 0.8784],
        "hex": "#faebe0"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9569, 0.898, 0.8588],
        "hex": "#f4e5db"
      }
    },
    "muted": {
