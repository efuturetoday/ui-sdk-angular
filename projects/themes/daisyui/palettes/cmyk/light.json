{
  "$description": "The daisyUI theme's cmyk palette, from daisyUI 5's cmyk theme, by scripts/build-daisyui.mjs. It's light only.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0863, 0.0863, 0.0863],
        "hex": "#161616"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9333, 0.9333, 0.9333],
        "hex": "#eeeeee"
      }
    },
    "muted": {
      "$description": "A quiet surface, like a hovered item or a button.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9333, 0.9333, 0.9333],
        "hex": "#eeeeee"
      }
    },
    "muted-foreground": {
      "$description": "Secondary text, like a description.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0863, 0.0863, 0.0863],
        "alpha": 0.6,
        "hex": "#161616"
      }
    },
    "primary": {
      "$description": "Fills that stand out, like a solid button or a checked checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2706, 0.6824, 0.9333],
        "hex": "#45aeee"
      }
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0078, 0.0431, 0.0745],
        "hex": "#020b13"
      }
    },
    "ring": {
      "$description": "The focus ring.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2706, 0.6824, 0.9333],
        "alpha": 0.4,
        "hex": "#45aeee"
      }
    },
    "input": {
      "$description": "The border of a control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0863, 0.0863, 0.0863],
        "alpha": 0.2,
        "hex": "#161616"
      }
    },
    "border": {
      "$description": "Dividers and quiet borders.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0863, 0.0863, 0.0863],
        "alpha": 0.1,
        "hex": "#161616"
      }
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0863, 0.0863, 0.0863],
        "alpha": 0.15,
        "hex": "#161616"
      }
    },
    "border-disabled": {
      "$description": "The border and text of a disabled control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0863, 0.0863, 0.0863],
        "alpha": 0.4,
        "hex": "#161616"
      }
    },
    "destructive": {
      "$description": "Errors.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9137, 0.2471, 0.2],
        "hex": "#e93f33"
      }
    },
    "destructive-muted": {
      "$description": "A surface behind an error.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9137, 0.2471, 0.2],
        "alpha": 0.12,
        "hex": "#e93f33"
      }
    },
    "overlay": {
      "$description": "Behind a modal dialog or drawer.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.4,
        "hex": "#000000"
      }
    }
  }
}
