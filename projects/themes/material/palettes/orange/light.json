    "overlay": {
      "$description": "Behind a modal dialog or drawer.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.32,
        "hex": "#000000"
      }
    },
    "field": {
      "$description": "The fill of a text field.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9373, 0.8784, 0.8353],
