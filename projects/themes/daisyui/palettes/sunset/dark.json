{
  "$description": "The daisyUI theme's sunset palette, from daisyUI 5's sunset theme, by scripts/build-daisyui.mjs. It's dark only.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0706, 0.1098, 0.1333],
        "hex": "#121c22"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6235, 0.7255, 0.8157],
        "hex": "#9fb9d0"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0706, 0.1098, 0.1333],
        "hex": "#121c22"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0706, 0.1098, 0.1333],
        "hex": "#121c22"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0549, 0.0902, 0.1176],
        "hex": "#0e171e"
      }
    },
    "muted": {
      "$description": "A quiet surface, like a hovered item or a button.",
