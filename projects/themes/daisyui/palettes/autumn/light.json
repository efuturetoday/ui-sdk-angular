{
  "$description": "The daisyUI theme's autumn palette, from daisyUI 5's autumn theme, by scripts/build-daisyui.mjs. It's light only.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9451, 0.9451, 0.9451],
        "hex": "#f1f1f1"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0784, 0.0784],
        "hex": "#141414"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9451, 0.9451, 0.9451],
        "hex": "#f1f1f1"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9451, 0.9451, 0.9451],
        "hex": "#f1f1f1"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8588, 0.8588, 0.8588],
        "hex": "#dbdbdb"
      }
    },
    "muted": {
      "$description": "A quiet surface, like a hovered item or a button.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8588, 0.8588, 0.8588],
        "hex": "#dbdbdb"
      }
    },
    "muted-foreground": {
      "$description": "Secondary text, like a description.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0784, 0.0784],
        "alpha": 0.6,
        "hex": "#141414"
      }
    },
    "primary": {
      "$description": "Fills that stand out, like a solid button or a checked checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.549, 0.0118, 0.1529],
        "hex": "#8c0327"
      }
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9294, 0.8157, 0.8157],
        "hex": "#edd0d0"
      }
    },
    "ring": {
      "$description": "The focus ring.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.549, 0.0118, 0.1529],
        "alpha": 0.4,
        "hex": "#8c0327"
      }
    },
    "input": {
      "$description": "The border of a control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0784, 0.0784],
        "alpha": 0.2,
        "hex": "#141414"
      }
    },
    "border": {
      "$description": "Dividers and quiet borders.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0784, 0.0784],
        "alpha": 0.1,
        "hex": "#141414"
      }
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0784, 0.0784],
        "alpha": 0.15,
        "hex": "#141414"
      }
    },
    "border-disabled": {
      "$description": "The border and text of a disabled control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0784, 0.0784, 0.0784],
        "alpha": 0.4,
        "hex": "#141414"
      }
    },
    "destructive": {
      "$description": "Errors.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8314, 0, 0.0784],
        "hex": "#d40014"
      }
    },
    "destructive-muted": {
      "$description": "A surface behind an error.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8314, 0, 0.0784],
        "alpha": 0.12,
        "hex": "#d40014"
      }
    },
    "overlay": {
      "$description": "Behind a modal dialog or drawer.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.4,
        "hex": "#000000"
      }
    }
  }
}
