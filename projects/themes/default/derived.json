{
  "--ui-ring": "color-mix(in oklab, var(--ui-primary) 22%, transparent)",
  "--ui-destructive-muted": "color-mix(in oklab, var(--ui-destructive) 9%, var(--ui-surface-2))",
  "--ui-radius-row": "calc(var(--ui-radius) * 0.875)",
  "--ui-radius-control": "var(--ui-radius)",
  "--ui-radius-surface": "calc(var(--ui-radius) * 1.25)",
  "--ui-radius-popup": "calc(var(--ui-radius) * 1.5)"
}
