        "colorSpace": "srgb",
        "components": [0.5137, 0.4549, 0.4078],
        "hex": "#837468"
      }
    },
    "border": {
      "$description": "Dividers and quiet borders.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8353, 0.7647, 0.7098],
        "hex": "#d5c3b5"
      }
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5137, 0.4549, 0.4078],
        "hex": "#837468"
      }
    },
    "border-disabled": {
      "$description": "The border and text of a disabled control.",
