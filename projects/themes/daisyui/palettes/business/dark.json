{
  "$description": "The daisyUI theme's business palette, from daisyUI 5's business theme, by scripts/build-daisyui.mjs. It's dark only.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1255, 0.1255, 0.1255],
        "hex": "#202020"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8039, 0.8039, 0.8039],
        "hex": "#cdcdcd"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1255, 0.1255, 0.1255],
        "hex": "#202020"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1255, 0.1255, 0.1255],
        "hex": "#202020"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1098, 0.1098, 0.1098],
        "hex": "#1c1c1c"
      }
    },
    "muted": {
      "$description": "A quiet surface, like a hovered item or a button.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1098, 0.1098, 0.1098],
        "hex": "#1c1c1c"
      }
    },
    "muted-foreground": {
      "$description": "Secondary text, like a description.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8039, 0.8039, 0.8039],
        "alpha": 0.6,
        "hex": "#cdcdcd"
      }
    },
    "primary": {
      "$description": "Fills that stand out, like a solid button or a checked checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1098, 0.3059, 0.502],
        "hex": "#1c4e80"
      }
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8157, 0.8549, 0.898],
        "hex": "#d0dae5"
      }
    },
    "ring": {
      "$description": "The focus ring.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1098, 0.3059, 0.502],
        "alpha": 0.4,
        "hex": "#1c4e80"
      }
    },
    "input": {
      "$description": "The border of a control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8039, 0.8039, 0.8039],
        "alpha": 0.2,
        "hex": "#cdcdcd"
      }
    },
    "border": {
      "$description": "Dividers and quiet borders.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8039, 0.8039, 0.8039],
        "alpha": 0.1,
        "hex": "#cdcdcd"
      }
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8039, 0.8039, 0.8039],
        "alpha": 0.15,
        "hex": "#cdcdcd"
      }
    },
    "border-disabled": {
      "$description": "The border and text of a disabled control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8039, 0.8039, 0.8039],
        "alpha": 0.4,
        "hex": "#cdcdcd"
      }
    },
    "destructive": {
      "$description": "Errors.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6745, 0.2431, 0.1922],
        "hex": "#ac3e31"
      }
    },
    "destructive-muted": {
      "$description": "A surface behind an error.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6745, 0.2431, 0.1922],
        "alpha": 0.12,
        "hex": "#ac3e31"
      }
    },
    "overlay": {
      "$description": "Behind a modal dialog or drawer.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.4,
        "hex": "#000000"
      }
    }
  }
}
