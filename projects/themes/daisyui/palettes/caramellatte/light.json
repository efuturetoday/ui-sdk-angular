{
  "$description": "The daisyUI theme's caramellatte palette, from daisyUI 5's caramellatte theme, by scripts/build-daisyui.mjs. It's light only.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.9686, 0.9294],
        "hex": "#fff7ed"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4863, 0.1569, 0.0314],
        "hex": "#7c2808"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.9686, 0.9294],
        "hex": "#fff7ed"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.9686, 0.9294],
        "hex": "#fff7ed"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9961, 0.9255, 0.8275],
        "hex": "#feecd3"
      }
    },
    "muted": {
      "$description": "A quiet surface, like a hovered item or a button.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9961, 0.9255, 0.8275],
        "hex": "#feecd3"
      }
    },
    "muted-foreground": {
      "$description": "Secondary text, like a description.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4863, 0.1569, 0.0314],
        "alpha": 0.6,
        "hex": "#7c2808"
      }
    },
    "primary": {
      "$description": "Fills that stand out, like a solid button or a checked checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "hex": "#000000"
      }
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "ring": {
      "$description": "The focus ring.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.4,
        "hex": "#000000"
      }
    },
    "input": {
      "$description": "The border of a control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4863, 0.1569, 0.0314],
        "alpha": 0.2,
        "hex": "#7c2808"
      }
    },
    "border": {
      "$description": "Dividers and quiet borders.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4863, 0.1569, 0.0314],
        "alpha": 0.1,
        "hex": "#7c2808"
      }
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4863, 0.1569, 0.0314],
        "alpha": 0.15,
        "hex": "#7c2808"
      }
    },
    "border-disabled": {
      "$description": "The border and text of a disabled control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4863, 0.1569, 0.0314],
        "alpha": 0.4,
        "hex": "#7c2808"
      }
    },
    "destructive": {
      "$description": "Errors.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.3843, 0.4],
        "hex": "#ff6266"
      }
    },
    "destructive-muted": {
      "$description": "A surface behind an error.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.3843, 0.4],
        "alpha": 0.12,
        "hex": "#ff6266"
      }
    },
    "overlay": {
      "$description": "Behind a modal dialog or drawer.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.4,
        "hex": "#000000"
      }
    }
  }
}
