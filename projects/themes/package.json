{
  "name": "@ngx-ui-sdk/themes",
  "version": "0.2.1",
  "description": "Themes for @ngx-ui-sdk/core, as plain CSS: ui-sdk's own, shadcn, Material and daisyUI, with palettes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efuturetoday/ui-sdk-angular.git",
    "directory": "projects/themes"
  },
  "homepage": "https://efuturetoday.github.io/ui-sdk-angular/",
  "bugs": "https://github.com/efuturetoday/ui-sdk-angular/issues",
  "keywords": [
    "angular",
    "ui-sdk",
    "css",
    "theme",
    "shadcn",
    "material",
    "daisyui"
  ],
  "style": "./default/all.css",
  "exports": {
    ".": "./default/all.css",
    "./*.css": "./*.css",
    "./*.json": "./*.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ]
}
