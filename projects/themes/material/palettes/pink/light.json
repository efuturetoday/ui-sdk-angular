{
  "$description": "The Material theme's pink palette in light, made from #E91E63 by scripts/build-material.mjs.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.9725, 0.9686],
        "hex": "#fff8f7"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1333, 0.098, 0.102],
        "hex": "#22191a"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.9725, 0.9686],
        "hex": "#fff8f7"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9843, 0.9176, 0.9216],
        "hex": "#fbeaeb"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9608, 0.8941, 0.898],
        "hex": "#f5e4e5"
      }
    },
    "muted": {
      "$description": "A quiet surface, like a hovered item.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1333, 0.098, 0.102],
        "alpha": 0.08,
        "hex": "#22191a"
      }
    },
    "muted-foreground": {
      "$description": "Secondary text, like a description.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.3216, 0.2627, 0.2706],
        "hex": "#524345"
      }
    },
    "primary": {
      "$description": "Fills that stand out, like a checked checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5569, 0.2863, 0.3412],
        "hex": "#8e4957"
      }
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "ring": {
      "$description": "The focus ring.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5569, 0.2863, 0.3412],
        "alpha": 0.4,
        "hex": "#8e4957"
      }
    },
    "input": {
      "$description": "The border of a control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5176, 0.451, 0.4588],
        "hex": "#847375"
      }
    },
    "border": {
      "$description": "Dividers and quiet borders.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8392, 0.7608, 0.7647],
        "hex": "#d6c2c3"
      }
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5176, 0.451, 0.4588],
        "hex": "#847375"
      }
    },
    "border-disabled": {
      "$description": "The border and text of a disabled control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1333, 0.098, 0.102],
        "alpha": 0.38,
        "hex": "#22191a"
      }
    },
    "destructive": {
      "$description": "Errors.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7294, 0.102, 0.102],
        "hex": "#ba1a1a"
      }
    },
    "destructive-muted": {
      "$description": "A surface behind an error.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.8549, 0.8392],
        "hex": "#ffdad6"
      }
    },
    "overlay": {
      "$description": "Behind a modal dialog or drawer.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.32,
        "hex": "#000000"
      }
    },
    "field": {
      "$description": "The fill of a text field.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9412, 0.8706, 0.8784],
        "hex": "#f0dee0"
      }
    }
  }
}
