{
  "$description": "The daisyUI theme's emerald palette, from daisyUI 5's emerald theme, by scripts/build-daisyui.mjs. It's light only.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2, 0.2353, 0.302],
        "hex": "#333c4d"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9098, 0.9098, 0.9098],
        "hex": "#e8e8e8"
      }
    },
    "muted": {
      "$description": "A quiet surface, like a hovered item or a button.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9098, 0.9098, 0.9098],
        "hex": "#e8e8e8"
      }
    },
    "muted-foreground": {
      "$description": "Secondary text, like a description.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2, 0.2353, 0.302],
        "alpha": 0.6,
        "hex": "#333c4d"
      }
    },
    "primary": {
      "$description": "Fills that stand out, like a solid button or a checked checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4, 0.8, 0.5412],
        "hex": "#66cc8a"
      }
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1333, 0.2392, 0.1882],
        "hex": "#223d30"
      }
    },
    "ring": {
      "$description": "The focus ring.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4, 0.8, 0.5412],
        "alpha": 0.4,
        "hex": "#66cc8a"
      }
    },
    "input": {
      "$description": "The border of a control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2, 0.2353, 0.302],
        "alpha": 0.2,
        "hex": "#333c4d"
      }
    },
    "border": {
      "$description": "Dividers and quiet borders.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2, 0.2353, 0.302],
        "alpha": 0.1,
        "hex": "#333c4d"
      }
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2, 0.2353, 0.302],
        "alpha": 0.15,
        "hex": "#333c4d"
      }
    },
    "border-disabled": {
      "$description": "The border and text of a disabled control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2, 0.2353, 0.302],
        "alpha": 0.4,
        "hex": "#333c4d"
      }
    },
    "destructive": {
      "$description": "Errors.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.3451, 0.3804],
        "hex": "#ff5861"
      }
    },
    "destructive-muted": {
      "$description": "A surface behind an error.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.3451, 0.3804],
        "alpha": 0.12,
        "hex": "#ff5861"
      }
    },
    "overlay": {
      "$description": "Behind a modal dialog or drawer.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.4,
        "hex": "#000000"
      }
    }
  }
}
