        "colorSpace": "srgb",
        "components": [0.5216, 0.3255, 0.0941],
        "hex": "#855318"
      }
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "ring": {
      "$description": "The focus ring.",
