        "colorSpace": "srgb",
        "components": [0.6235, 0.7255, 0.8157],
        "alpha": 0.6,
        "hex": "#9fb9d0"
      }
    },
    "primary": {
      "$description": "Fills that stand out, like a solid button or a checked checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.5255, 0.3569],
        "hex": "#ff865b"
      }
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0863, 0.0235, 0.0118],
        "hex": "#160603"
      }
    },
    "ring": {
      "$description": "The focus ring.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.5255, 0.3569],
        "alpha": 0.4,
        "hex": "#ff865b"
      }
    },
    "input": {
      "$description": "The border of a control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6235, 0.7255, 0.8157],
        "alpha": 0.2,
        "hex": "#9fb9d0"
      }
    },
    "border": {
      "$description": "Dividers and quiet borders.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6235, 0.7255, 0.8157],
        "alpha": 0.1,
        "hex": "#9fb9d0"
      }
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6235, 0.7255, 0.8157],
        "alpha": 0.15,
        "hex": "#9fb9d0"
      }
    },
    "border-disabled": {
      "$description": "The border and text of a disabled control.",
