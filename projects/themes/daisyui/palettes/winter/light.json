{
  "$description": "The daisyUI theme's winter palette, from daisyUI 5's winter theme, by scripts/build-daisyui.mjs. It's light only.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2235, 0.3059, 0.4157],
        "hex": "#394e6a"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.949, 0.9686, 0.9961],
        "hex": "#f2f7fe"
      }
    },
    "muted": {
      "$description": "A quiet surface, like a hovered item or a button.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.949, 0.9686, 0.9961],
        "hex": "#f2f7fe"
      }
    },
    "muted-foreground": {
      "$description": "Secondary text, like a description.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2235, 0.3059, 0.4157],
        "alpha": 0.6,
        "hex": "#394e6a"
      }
    },
    "primary": {
      "$description": "Fills that stand out, like a solid button or a checked checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0.4118, 1],
        "hex": "#0069ff"
      }
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8078, 0.8941, 1],
        "hex": "#cee4ff"
      }
    },
    "ring": {
      "$description": "The focus ring.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0.4118, 1],
        "alpha": 0.4,
        "hex": "#0069ff"
      }
    },
    "input": {
      "$description": "The border of a control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2235, 0.3059, 0.4157],
        "alpha": 0.2,
        "hex": "#394e6a"
      }
    },
    "border": {
      "$description": "Dividers and quiet borders.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2235, 0.3059, 0.4157],
        "alpha": 0.1,
        "hex": "#394e6a"
      }
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2235, 0.3059, 0.4157],
        "alpha": 0.15,
        "hex": "#394e6a"
      }
    },
    "border-disabled": {
      "$description": "The border and text of a disabled control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2235, 0.3059, 0.4157],
        "alpha": 0.4,
        "hex": "#394e6a"
      }
    },
    "destructive": {
      "$description": "Errors.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.898, 0.5451, 0.5451],
        "hex": "#e58b8b"
      }
    },
    "destructive-muted": {
      "$description": "A surface behind an error.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.898, 0.5451, 0.5451],
        "alpha": 0.12,
        "hex": "#e58b8b"
      }
    },
    "overlay": {
      "$description": "Behind a modal dialog or drawer.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.4,
        "hex": "#000000"
      }
    }
  }
}
