{
  "$description": "The daisyUI theme's halloween palette, from daisyUI 5's halloween theme, by scripts/build-daisyui.mjs. It's dark only.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.0941, 0.0863],
        "hex": "#1b1816"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8039, 0.8039, 0.8039],
        "hex": "#cdcdcd"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.0941, 0.0863],
        "hex": "#1b1816"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.0941, 0.0863],
        "hex": "#1b1816"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
