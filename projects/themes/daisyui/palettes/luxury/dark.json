{
  "$description": "The daisyUI theme's luxury palette, from daisyUI 5's luxury theme, by scripts/build-daisyui.mjs. It's dark only.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0353, 0.0353, 0.0431],
        "hex": "#09090b"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8627, 0.6471, 0.302],
        "hex": "#dca54d"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0353, 0.0353, 0.0431],
        "hex": "#09090b"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0353, 0.0353, 0.0431],
        "hex": "#09090b"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0902, 0.0863, 0.0941],
        "hex": "#171618"
      }
    },
    "muted": {
      "$description": "A quiet surface, like a hovered item or a button.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0902, 0.0863, 0.0941],
        "hex": "#171618"
      }
    },
    "muted-foreground": {
      "$description": "Secondary text, like a description.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8627, 0.6471, 0.302],
        "alpha": 0.6,
        "hex": "#dca54d"
      }
    },
    "primary": {
      "$description": "Fills that stand out, like a solid button or a checked checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0863, 0.0863, 0.0863],
        "hex": "#161616"
      }
    },
    "ring": {
      "$description": "The focus ring.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 0.4,
        "hex": "#ffffff"
      }
    },
    "input": {
      "$description": "The border of a control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8627, 0.6471, 0.302],
        "alpha": 0.2,
        "hex": "#dca54d"
      }
    },
    "border": {
      "$description": "Dividers and quiet borders.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8627, 0.6471, 0.302],
        "alpha": 0.1,
        "hex": "#dca54d"
      }
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8627, 0.6471, 0.302],
        "alpha": 0.15,
        "hex": "#dca54d"
      }
    },
    "border-disabled": {
      "$description": "The border and text of a disabled control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8627, 0.6471, 0.302],
        "alpha": 0.4,
        "hex": "#dca54d"
      }
    },
    "destructive": {
      "$description": "Errors.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.4353, 0.4353],
        "hex": "#ff6f6f"
      }
    },
    "destructive-muted": {
      "$description": "A surface behind an error.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.4353, 0.4353],
        "alpha": 0.12,
        "hex": "#ff6f6f"
      }
    },
    "overlay": {
      "$description": "Behind a modal dialog or drawer.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.4,
        "hex": "#000000"
      }
    }
  }
}
