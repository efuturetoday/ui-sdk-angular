{
  "$description": "The daisyUI theme's forest palette, from daisyUI 5's forest theme, by scripts/build-daisyui.mjs. It's dark only.",
  "color": {
    "$type": "color",
    "background": {
      "$description": "The page.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.0902, 0.0902],
        "hex": "#1b1717"
      }
    },
    "foreground": {
      "$description": "Text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7922, 0.7882, 0.7882],
        "hex": "#cac9c9"
      }
    },
    "surface-1": {
      "$description": "Controls, like a button or an input.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.0902, 0.0902],
        "hex": "#1b1717"
      }
    },
    "surface-2": {
      "$description": "Popups, like a menu or a dialog.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.0902, 0.0902],
        "hex": "#1b1717"
      }
    },
    "surface-3": {
      "$description": "A surface on a popup.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0863, 0.0706, 0.0706],
        "hex": "#161212"
      }
    },
    "muted": {
      "$description": "A quiet surface, like a hovered item or a button.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0863, 0.0706, 0.0706],
        "hex": "#161212"
      }
    },
    "muted-foreground": {
      "$description": "Secondary text, like a description.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7922, 0.7882, 0.7882],
        "alpha": 0.6,
        "hex": "#cac9c9"
      }
    },
    "primary": {
      "$description": "Fills that stand out, like a solid button or a checked checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1216, 0.7216, 0.3294],
        "hex": "#1fb854"
      }
    },
    "primary-foreground": {
      "$description": "Text and icons on the primary color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "hex": "#000000"
      }
    },
    "ring": {
      "$description": "The focus ring.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1216, 0.7216, 0.3294],
        "alpha": 0.4,
        "hex": "#1fb854"
      }
    },
    "input": {
      "$description": "The border of a control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7922, 0.7882, 0.7882],
        "alpha": 0.2,
        "hex": "#cac9c9"
      }
    },
    "border": {
      "$description": "Dividers and quiet borders.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7922, 0.7882, 0.7882],
        "alpha": 0.1,
        "hex": "#cac9c9"
      }
    },
    "border-strong": {
      "$description": "The border of a button or a checkbox.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7922, 0.7882, 0.7882],
        "alpha": 0.15,
        "hex": "#cac9c9"
      }
    },
    "border-disabled": {
      "$description": "The border and text of a disabled control.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7922, 0.7882, 0.7882],
        "alpha": 0.4,
        "hex": "#cac9c9"
      }
    },
    "destructive": {
      "$description": "Errors.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.3451, 0.3804],
        "hex": "#ff5861"
      }
    },
    "destructive-muted": {
      "$description": "A surface behind an error.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.3451, 0.3804],
        "alpha": 0.12,
        "hex": "#ff5861"
      }
    },
    "overlay": {
      "$description": "Behind a modal dialog or drawer.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.4,
        "hex": "#000000"
      }
    }
  }
}
